[Appearance]
BoldIntense=true
ColorScheme=DarkOneNuanced
Font=IntoneMono Nerd Font,12,-1,5,50,0,0,0,0,0
FontHinting=true
UseFontLineChararacters=true

[Cursor Options]
CursorShape=0

[General]
Command=/usr/bin/zsh
Name=Host
Parent=FALLBACK/
SemanticInputClick=true
TerminalCenter=true

[Interaction Options]
UnderlineFilesEnabled=true

[Scrolling]
ScrollBarPosition=2

[Terminal Features]
VerticalLine=false
VerticalLineAtChar=100
